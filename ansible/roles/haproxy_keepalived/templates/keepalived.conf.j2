global_defs {
  enable_script_security
  script_user root
}

vrrp_script chk_haproxy {
  script "pidof haproxy"
  interval 2
  weight 2
}

vrrp_instance VI_1 {
  state BACKUP
  interface {{ keepalived_interface | default('eth0') }}
  virtual_router_id 51
  priority {{ keepalived_priority | default(100) }}
  advert_int 1
{% if keepalived_unicast | default(true) | bool %}
  unicast_src_ip {{ node_ip | default(ansible_host) }}
  unicast_peer {
{% for peer in groups['rke2_servers'] | default([]) %}
{% if peer != inventory_hostname %}
    {{ hostvars[peer].node_ip | default(hostvars[peer].ansible_host) }}
{% endif %}
{% endfor %}
  }
{% endif %}
  authentication {
    auth_type PASS
    auth_pass {{ keepalived_auth_pass }}
  }
  virtual_ipaddress {
    {{ cluster_vip }}
  }
  track_script {
    chk_haproxy
  }
}
